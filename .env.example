# Shared deterministic identities used by the local seed/bootstrap flow.
GLINT_ENVIRONMENT=development
GLINT_WORKSPACE_ID=11111111-1111-5111-8111-111111111111

# FastAPI. JSON syntax is required for list-valued settings.
GLINT_DATABASE_URL=sqlite:///./data/glint.db
GLINT_ALLOWED_ORIGINS='["http://127.0.0.1:5173","http://localhost:5173"]'
GLINT_CREATE_SCHEMA_ON_STARTUP=true
GLINT_AUTH_AUDIENCE=glint-api
# Production requires a random secret of at least 32 bytes and signed,
# short-lived access tokens. Development also accepts a UUID fixture token.
# GLINT_AUTH_HMAC_SECRET=replace-with-a-random-32-byte-minimum-secret
# GLINT_AUTH_ISSUER=https://identity.example.com
GLINT_IDEMPOTENCY_RETENTION_SECONDS=86400
GLINT_UPLOAD_GRANT_TTL_SECONDS=900
GLINT_MAX_IMPORT_BYTES=10000000
GLINT_SSE_POLL_INTERVAL_SECONDS=0.1

# Phase 3 model research is fail-closed and disabled by default. Enabling the
# server policy only permits runs whose immutable scope also sets
# allow_cloud_model=true. The API never needs the provider secret.
GLINT_MODEL_RUNTIME_ENABLED=false
GLINT_DEEPSEEK_MODEL=deepseek-v4-flash
# The worker reads these only for an authorized model run. Keep the key in an
# ignored local environment file or secret manager; never commit it.
# DEEPSEEK_API_KEY=<secret-manager-value>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Browser/Tauri REST client. The client fails closed when any identity is absent.
VITE_GLINT_DATA_MODE=api
VITE_GLINT_API_URL=http://127.0.0.1:8000
VITE_GLINT_WORKSPACE_ID=11111111-1111-5111-8111-111111111111
# Development-only UUID fixture. Production receives a signed short-lived token
# from the session/auth boundary; never commit a production token here.
VITE_GLINT_ACCESS_TOKEN=22222222-2222-5222-8222-222222222222

# Development object store. Docker Compose overrides this with MinIO/S3.
GLINT_OBJECT_STORE_BACKEND=filesystem
GLINT_OBJECT_STORE_ROOT=./.glint-objects

# Worker and connector wiring used by the production-like Compose runtime.
GLINT_WORKER_MODE=production
GLINT_WORKER_ID=glint-worker-1
GLINT_WORKER_LEASE_SECONDS=120
GLINT_WORKER_POLL_INTERVAL_SECONDS=2
GLINT_REDIS_URL=redis://127.0.0.1:6379/0
GLINT_API_OBJECT_STORE=services.api.app.core.object_store:get_object_store
GLINT_CONNECTOR_FACTORY=connectors.factory:create_connector_factory
GLINT_CONNECTOR_MAX_RESPONSE_BYTES=2000000
# Production signs opaque connector cursors to reject tampering.
# GLINT_CONNECTOR_CURSOR_SECRET=replace-with-a-random-32-byte-minimum-secret

# S3-compatible object storage (required when GLINT_ENVIRONMENT=production).
# GLINT_OBJECT_STORE_BACKEND=s3
# GLINT_S3_ENDPOINT_URL=http://127.0.0.1:9000
# GLINT_S3_BUCKET=glint-objects
# GLINT_S3_REGION=us-east-1
# GLINT_S3_ACCESS_KEY_ID=glint_minio
# GLINT_S3_SECRET_ACCESS_KEY=replace-me

# Phase 2 credentials are referenced by logical ref (for example
# env://github_token) and resolved only through the GLINT_SECRET_ namespace.
# Never put a token inline in a SourceConnection or schedule payload.
# GLINT_SECRET_GITHUB_TOKEN=replace-me

# Live connector smoke is manual-only and never enabled by default or CI.
# GitHub is skipped when its secret reference or cursor-signing secret is absent;
# RSS still runs because it requires no credential. Never place a real token here.
# GLINT_ENABLE_LIVE_SMOKE=1
