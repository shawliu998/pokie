# Copy into the environment that starts the API-mode Playwright run.
GLINT_E2E_API_MODE=external
GLINT_E2E_API_URL=http://127.0.0.1:8000
GLINT_E2E_WORKSPACE_ID=11111111-1111-5111-8111-111111111111
# Filled by scripts/verify_phase1.sh after the production auth seed.
GLINT_E2E_ACCESS_TOKEN=replace-with-seeded-access-token
VITE_GLINT_DATA_MODE=api
VITE_GLINT_API_URL=http://127.0.0.1:8000
VITE_GLINT_WORKSPACE_ID=11111111-1111-5111-8111-111111111111
VITE_GLINT_ACCESS_TOKEN=replace-with-seeded-access-token
