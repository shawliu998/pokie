{
  "name": "@glint/mac",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "lint": "eslint src e2e --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:bulk": "node scripts/audit-pnpm-lock.mjs",
    "audit:bulk:prod": "node scripts/audit-pnpm-lock.mjs --prod",
    "verify:secure-bundle": "node scripts/verify-secure-bundle.mjs",
    "package:mac": "tauri build --bundles app,dmg --ci && node scripts/verify-macos-package.mjs",
    "verify:package": "node scripts/verify-macos-package.mjs",
    "tauri:check": "tauri info"
  },
  "dependencies": {
    "@glint/ui": "workspace:*",
    "cmdk": "1.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-resizable-panels": "4.12.2"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.35.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
